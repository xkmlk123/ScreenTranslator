<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕实时翻译器" Height="700" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        MinWidth="420" MinHeight="700">
    <Grid Margin="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 翻译模式开关 -->
                <TextBlock Text="翻译模式：" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_Changed" Margin="0,0,0,10">
                    <ComboBoxItem Content="云端大模型 API（DeepSeek 等）" Tag="Cloud" IsSelected="True"/>
                    <ComboBoxItem Content="本地大模型（Ollama，无需联网）" Tag="Local"/>
                </ComboBox>

                <!-- 云端配置区 -->
                <StackPanel x:Name="CloudPanel">
                    <TextBlock Text="API 地址：" Margin="0,0,0,3"/>
                    <TextBox x:Name="ApiUrlBox" Margin="0,0,0,6"/>
                    <TextBlock Text="API Key：" Margin="0,0,0,3"/>
                    <TextBox x:Name="ApiKeyBox" Margin="0,0,0,6"/>
                    <TextBlock Text="模型名称：" Margin="0,0,0,3"/>
                    <TextBox x:Name="ModelBox" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- 本地配置区 -->
                <StackPanel x:Name="LocalPanel" Visibility="Collapsed">
                    <TextBlock Text="本地服务地址：" Margin="0,0,0,3"/>
                    <TextBox x:Name="LocalUrlBox" Margin="0,0,0,6"/>
                    <TextBlock Text="本地模型名称：" Margin="0,0,0,3"/>
                    <TextBox x:Name="LocalModelBox" Margin="0,0,0,6"/>
                    <TextBlock Text="提示：需先安装并启动 Ollama（ollama pull qwen2.5:7b）"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- 目标窗口 -->
                <TextBlock Text="目标窗口：" FontWeight="Bold" Margin="0,0,0,4"/>
                <UniformGrid Rows="1" Columns="2">
                    <ComboBox x:Name="WindowCombo" DisplayMemberPath="Title" Margin="0,0,5,0"/>
                    <Button Content="刷新" Click="RefreshWindows_Click"/>
                </UniformGrid>

                <Button x:Name="ToggleBtn" Content="▶ 开启翻译"
                        Click="Toggle_Click" FontSize="18" FontWeight="Bold"
                        Height="50" Margin="0,18,0,8"
                        Background="#4CAF50" Foreground="White"/>

                <TextBlock x:Name="HotkeyHint" Text="全局热键：Alt+T" Foreground="Gray"
                           FontSize="11" Margin="0,0,0,10"/>

                <!--  识别区域：手动框选；不框选则识别整个目标窗口  -->
                <Border Background="#F3F6FF" BorderBrush="#B9C7F0" BorderThickness="1"
                        CornerRadius="4" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="识别区域" FontWeight="Bold"/>
                        <TextBlock x:Name="RoiInfoText" Text="未选择区域（识别整个目标窗口）"
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,3,0,6"/>
                        <UniformGrid Rows="1" Columns="2">
                            <Button x:Name="PickRoiBtn" Content="⬚ 选择识别区域"
                                    Click="PickRoi_Click" Height="30" Margin="0,0,4,0"/>
                            <Button x:Name="ClearRoiBtn" Content="清除区域（恢复整窗）"
                                    Click="ClearRoi_Click" Height="30" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="提示：框选后只识别框内（绿色细线标出范围）；不框选则识别整个目标窗口。框选时按 Esc 取消。"
                                   Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!--  仅显示识别框：跳过翻译，只画 OCR 框，用于单独校验识别效果  -->
                <Border Background="#F3F6FF" BorderBrush="#B9C7F0" BorderThickness="1"
                        CornerRadius="4" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="OcrBoxesOnlyCheck"
                                  Content="仅显示识别框（不翻译）"
                                  FontWeight="Bold" Checked="OcrBoxesOnly_Changed"
                                  Unchecked="OcrBoxesOnly_Changed"/>
                        <CheckBox x:Name="OcrBoxesTextCheck" Content="标注原文与置信度"
                                  Margin="0,4,0,0" Checked="OcrBoxesText_Changed"
                                  Unchecked="OcrBoxesText_Changed"/>
                        <CheckBox x:Name="ShowOriginalOnlyCheck"
                                  Content="只显示原文（不翻译）"
                                  Margin="0,4,0,0" Checked="ShowOriginalOnly_Changed"
                                  Unchecked="ShowOriginalOnly_Changed"/>
                        <CheckBox x:Name="ForceGdiCheck"
                                  Content="用 GDI 捕获（备用模式）"
                                  Margin="0,4,0,0" Checked="ForceGdi_Changed"
                                  Unchecked="ForceGdi_Changed"/>
                        <CheckBox x:Name="SkipReadbackCheck"
                                  Content="WGC 仅计数不取像素（诊断）"
                                  Foreground="#B26A00"
                                  Margin="0,4,0,0" Checked="SkipReadback_Changed"
                                  Unchecked="SkipReadback_Changed"/>
                    </StackPanel>
                </Border>

                <Border Background="#F5F5F5" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                        MinHeight="110" VerticalAlignment="Top">
                    <TextBlock x:Name="StatusText" Text="状态：已停止" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Border>

                <UniformGrid Rows="1" Columns="4">
                    <Button Content="⚙ 设置" Click="Settings_Click" Height="35" Margin="0,0,4,0"/>
                    <Button Content="清缓存" Click="ClearCache_Click" Height="35" Margin="4,0,4,0"/>
                    <Button Content="导出诊断" Click="CopyDiag_Click" Height="35" Margin="4,0,4,0"/>
                    <Button Content="退出" Click="Exit_Click" Height="35" Margin="4,0,0,0"
                            Background="#F44336" Foreground="White"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
