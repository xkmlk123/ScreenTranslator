<Window x:Class="ScreenTranslator.Windows.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="1920" Height="1080"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        Cursor="Cross">
    <Canvas x:Name="SelectCanvas" Background="Transparent" ClipToBounds="True"/>
</Window>
